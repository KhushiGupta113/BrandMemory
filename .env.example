# Database Connection (PostgreSQL with pgvector & full-text search)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brandmemory?schema=public"

# Multi-Tenancy & Authorization
# Default active demo tenant ("kalyani-botanicals" or custom uuid)
DEFAULT_WORKSPACE_ID="ws-kalyani-botanicals"
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
AUTH_SECRET="super-secret-auth-key-replace-in-production"

# Retrieval & Vector Configuration
# Options: "openai" | "voyage" | "local" | "demo" (demo uses deterministic simulated embeddings if no API key is provided)
EMBEDDING_PROVIDER="demo"
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

# RAG & Generation Configuration
# Options: "openai" | "anthropic" | "demo"
LLM_PROVIDER="demo"
LLM_MODEL="gpt-4o-mini"
MAX_RETRIEVAL_K=5
RRF_K=60

# Port & Node Environment
NODE_ENV="development"
PORT=3000
